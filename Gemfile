source "https://rubygems.org"

# For local preview only — `bundle exec jekyll serve`.
#
# GitHub Pages builds this site with its own pinned toolchain (Jekyll 3.9 via the
# github-pages gem), which is not installable on current Ruby. The templates here
# deliberately stick to Liquid features common to both (include, for, if, case,
# default/strip filters, relative_url/absolute_url, site.data), so what you see
# locally is what Pages publishes.
gem "jekyll", "~> 4.4"
gem "jekyll-sitemap", "~> 1.4"
